{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wsl-agent-sandbox Configuration (Hardened Ubuntu 26.04 LTS WSL2 Sandbox)",
  "type": "object",
  "required": [
    "distroName",
    "installDir",
    "agentUser",
    "image",
    "sharedFolders",
    "network",
    "docker",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "distroName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,62}$",
      "description": "Dedicated WSL distribution name."
    },
    "installDir": {
      "type": "string",
      "minLength": 1,
      "description": "Windows directory where the WSL ext4.vhdx will live. Supports %ENVVAR% expansion."
    },
    "agentUser": {
      "type": "object",
      "required": ["name", "uid", "gid"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "uid": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 60000,
          "description": "Dedicated high UID so per-UID nftables rules do not collide with UID 1000 in other WSL distros."
        },
        "gid": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 60000
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["release", "arch", "cacheDir"],
      "properties": {
        "release": {
          "type": "string",
          "default": "26.04"
        },
        "arch": {
          "type": "string",
          "enum": ["amd64", "arm64"]
        },
        "url": {
          "type": "string",
          "description": "Optional explicit download URL for the .wsl or .tar.gz rootfs."
        },
        "sha256": {
          "type": "string",
          "description": "Optional explicit SHA256 checksum (otherwise fetched from Canonical SHA256SUMS)."
        },
        "cacheDir": {
          "type": "string"
        }
      }
    },
    "sharedFolders": {
      "type": "array",
      "description": "Explicit allowlist of Windows directories mounted under /shared/<name> inside WSL.",
      "items": {
        "type": "object",
        "required": ["name", "windowsPath", "mode"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
          },
          "windowsPath": {
            "type": "string",
            "pattern": "^[A-Za-z]:\\\\.+$"
          },
          "mode": {
            "type": "string",
            "enum": ["ro", "rw"]
          },
          "allowDockerBind": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "network": {
      "type": "object",
      "description": "Per-UID nftables and mirrored-loopback isolation policy for the agent user.",
      "required": ["blockHostAndLan", "allowedHostPorts", "blockedCidrs"],
      "properties": {
        "blockHostAndLan": {
          "type": "boolean",
          "description": "When true, blocks direct agent egress to Windows host ports (including mirrored localhost/loopback0 port-forwards) and blockedCidrs."
        },
        "allowedHostPorts": {
          "type": "array",
          "description": "Explicit Windows host ports (e.g., kubectl port-forward, SSH tunnels, local Ollama) reachable by the agent user. Works directly on localhost in mirrored mode; in NAT mode bind the Windows listener to the vEthernet (WSL) IP or 0.0.0.0.",
          "items": {
            "type": "object",
            "required": ["port", "protocol"],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "type": "string",
                "enum": ["tcp", "udp"]
              },
              "comment": {
                "type": "string"
              }
            }
          }
        },
        "blockedCidrs": {
          "type": "array",
          "description": "IPv4/IPv6 CIDR ranges dropped for outbound agent traffic when blockHostAndLan is true.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "docker": {
      "type": "object",
      "required": ["enabled", "allowBindPrefixes", "allowBuildKit", "allowCapAdd"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable mediated Docker Desktop access via docker-policy-proxy. Note: Docker Desktop bridge containers can still reach Windows host/port-forwarded services via host.docker.internal unless disabled here or blocked by Windows Firewall."
        },
        "allowBindPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/.*"
          }
        },
        "allowBuildKit": {
          "type": "boolean"
        },
        "allowCapAdd": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denyEndpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "required": ["apt"],
      "properties": {
        "apt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "installDockerCli": { "type": "boolean" },
        "installUv": { "type": "boolean" },
        "installNodeLts": { "type": "boolean" },
        "installPnpm": { "type": "boolean" },
        "installGeminiCli": { "type": "boolean" },
        "installClaudeCode": { "type": "boolean" },
        "installKubectl": { "type": "boolean" },
        "installAwsCli": { "type": "boolean" },
        "installGcloudCli": { "type": "boolean" },
        "installAzureCli": { "type": "boolean" },
        "installAzureDevopsCli": { "type": "boolean" },
        "installGithubCli": { "type": "boolean" },
        "installJiraCli": { "type": "boolean" },
        "installUpctl": { "type": "boolean" },
        "installDotnetSdk": { "type": "boolean" },
        "installRust": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "description": "Optional non-secret Windows path pointer for central CLI credential seeding via '.\\box.ps1 seed-secrets'. Never store secret values in box.json.",
      "additionalProperties": false,
      "properties": {
        "manifestPath": {
          "type": "string",
          "description": "Path to the central Windows secrets manifest JSON file (supports %ENVVAR% expansion). Defaults to %USERPROFILE%\\.wsl-agent-sandbox\\secrets.json."
        }
      }
    }
  }
}
