{
  "$schema": "https://raw.githubusercontent.com/Thorup/wsl-agent-sandbox/main/secrets.schema.json",
  "github": {
    "enabled": true,
    "hostname": "github.com",
    "token": "github_pat_REPLACE_ME",
    "user": "sandbox-bot",
    "gitProtocol": "https",
    "setupGit": true,
    "exportEnv": true,
    "loginOnline": false
  },
  "aws": {
    "enabled": false,
    "profile": "default",
    "accessKeyId": "AKIA_REPLACE_ME",
    "secretAccessKey": "REPLACE_ME",
    "region": "eu-north-1",
    "output": "json"
  },
  "gcloud": {
    "enabled": false,
    "serviceAccountKeyFile": "keys/gcp-sandbox-sa.json",
    "project": "my-sandbox-project",
    "region": "europe-north1",
    "setApplicationDefaultCredentials": true
  },
  "azure": {
    "enabled": false,
    "clientId": "00000000-0000-0000-0000-000000000000",
    "tenantId": "00000000-0000-0000-0000-000000000000",
    "clientSecretFile": "tokens/azure-sp-secret.txt",
    "subscription": "00000000-0000-0000-0000-000000000000",
    "exportEnv": true
  },
  "azureDevops": {
    "enabled": false,
    "organization": "https://dev.azure.com/my-org",
    "project": "my-sandbox-project",
    "patFile": "tokens/ado-pat.txt"
  },
  "jira": {
    "enabled": false,
    "server": "https://my-org.atlassian.net",
    "login": "sandbox-bot@example.com",
    "apiToken": "ATATT_REPLACE_ME",
    "installation": "cloud",
    "authType": "basic",
    "projectKey": "SANDBOX"
  },
  "upcloud": {
    "enabled": false,
    "token": "ucat_REPLACE_ME",
    "exportEnv": true
  },
  "kubectl": {
    "enabled": false,
    "kubeconfigFile": "keys/sandbox-kubeconfig.yaml",
    "context": "sandbox-cluster"
  },
  "gemini": {
    "enabled": false,
    "apiKeyEnv": "SANDBOX_GEMINI_API_KEY"
  },
  "claude": {
    "enabled": false,
    "apiKeyFile": "tokens/anthropic-api-key.txt"
  },
  "env": {
    "NPM_TOKEN": {
      "valueEnv": "SANDBOX_NPM_TOKEN"
    }
  },
  "files": [
    {
      "name": "sandbox-npmrc",
      "enabled": false,
      "sourcePath": "files/npmrc",
      "targetPath": "~/.npmrc",
      "mode": "0600"
    }
  ]
}
