{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wsl-agent-sandbox Central Windows Secrets Manifest",
  "description": "Central Windows-side manifest used by '.\\box.ps1 seed-secrets' to seed and rotate CLI machine account tokens and service account credentials inside WSL without storing secrets in git or exposing Windows directories to the sandbox.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "github": {
      "type": "object",
      "description": "GitHub CLI (gh) and git HTTPS credential helper using a machine account or fine-grained PAT.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "hostname": { "type": "string", "default": "github.com" },
        "token": { "type": "string" },
        "tokenFile": { "type": "string", "description": "Windows path (relative to manifest directory or absolute, supports %ENVVAR%) to a file containing the token." },
        "tokenEnv": { "type": "string", "description": "Name of a Windows environment variable containing the token." },
        "user": { "type": "string", "description": "Optional GitHub username recorded in ~/.config/gh/hosts.yml." },
        "gitProtocol": { "type": "string", "enum": ["https", "ssh"], "default": "https" },
        "setupGit": { "type": "boolean", "default": true, "description": "Configure git credential helper via 'gh auth setup-git'." },
        "exportEnv": { "type": "boolean", "default": true, "description": "Also export GH_TOKEN (or GH_ENTERPRISE_TOKEN for non-github.com hosts) in secrets.env." },
        "loginOnline": { "type": "boolean", "default": false, "description": "If true, authenticate via 'gh auth login --with-token' (validates token online against GitHub API)." }
      }
    },
    "aws": {
      "type": "object",
      "description": "AWS CLI v2 IAM access keys / STS credentials merged into ~/.aws/credentials and ~/.aws/config.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "profile": { "type": "string", "default": "default" },
        "accessKeyId": { "type": "string" },
        "accessKeyIdFile": { "type": "string" },
        "accessKeyIdEnv": { "type": "string" },
        "secretAccessKey": { "type": "string" },
        "secretAccessKeyFile": { "type": "string" },
        "secretAccessKeyEnv": { "type": "string" },
        "sessionToken": { "type": "string" },
        "sessionTokenFile": { "type": "string" },
        "sessionTokenEnv": { "type": "string" },
        "region": { "type": "string" },
        "output": { "type": "string", "enum": ["json", "yaml", "yaml-stream", "text", "table"] },
        "defaultProfile": { "type": "string", "description": "Optional AWS_PROFILE exported in secrets.env." },
        "profiles": {
          "type": "array",
          "description": "Optional list of multiple named AWS profiles.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
              "accessKeyId": { "type": "string" },
              "accessKeyIdFile": { "type": "string" },
              "accessKeyIdEnv": { "type": "string" },
              "secretAccessKey": { "type": "string" },
              "secretAccessKeyFile": { "type": "string" },
              "secretAccessKeyEnv": { "type": "string" },
              "sessionToken": { "type": "string" },
              "sessionTokenFile": { "type": "string" },
              "sessionTokenEnv": { "type": "string" },
              "region": { "type": "string" },
              "output": { "type": "string", "enum": ["json", "yaml", "yaml-stream", "text", "table"] }
            }
          }
        }
      }
    },
    "gcloud": {
      "type": "object",
      "description": "Google Cloud CLI (gcloud) and GCP SDKs authenticated via a Service Account JSON key.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "serviceAccountKeyFile": { "type": "string", "description": "Windows path (relative to manifest directory or absolute, supports %ENVVAR%) to a GCP Service Account JSON key file." },
        "serviceAccountKeyJson": { "type": ["string", "object"], "description": "Optional inline GCP Service Account JSON key." },
        "project": { "type": "string", "description": "Optional GCP project ID (defaults to project_id inside the Service Account key)." },
        "region": { "type": "string" },
        "zone": { "type": "string" },
        "setApplicationDefaultCredentials": { "type": "boolean", "default": true, "description": "Export GOOGLE_APPLICATION_CREDENTIALS pointing to the seeded key file." },
        "skipActivate": { "type": "boolean", "default": false, "description": "If true, place the key file and configure project/env without calling 'gcloud auth activate-service-account' online." }
      }
    },
    "azure": {
      "type": "object",
      "description": "Microsoft Azure CLI (az) and Azure SDKs authenticated via an Entra ID Service Principal.",
      "additionalProperties": false,
      "required": ["clientId", "tenantId"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "clientId": { "type": "string", "description": "Service Principal Application (client) ID." },
        "tenantId": { "type": "string", "description": "Microsoft Entra ID Tenant ID." },
        "clientSecret": { "type": "string" },
        "clientSecretFile": { "type": "string" },
        "clientSecretEnv": { "type": "string" },
        "certificateFile": { "type": "string", "description": "Windows path to a PEM certificate file (mutually exclusive with clientSecret)." },
        "subscription": { "type": "string", "description": "Optional default subscription ID or name." },
        "allowNoSubscriptions": { "type": "boolean", "default": false },
        "exportEnv": { "type": "boolean", "default": true, "description": "Export AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET/AZURE_CLIENT_CERTIFICATE_PATH, and AZURE_SUBSCRIPTION_ID." },
        "skipLogin": { "type": "boolean", "default": false, "description": "If true, only export env/cert without calling 'az login --service-principal' online." }
      }
    },
    "azureDevops": {
      "type": "object",
      "description": "Azure DevOps CLI ('az devops') authenticated via Personal Access Token (AZURE_DEVOPS_EXT_PAT).",
      "additionalProperties": false,
      "required": ["organization"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "organization": { "type": "string", "description": "Azure DevOps organization URL (e.g. https://dev.azure.com/myorg)." },
        "project": { "type": "string", "description": "Optional default Azure DevOps project." },
        "pat": { "type": "string" },
        "patFile": { "type": "string" },
        "patEnv": { "type": "string" }
      }
    },
    "jira": {
      "type": "object",
      "description": "Jira CLI (ankitpokhrel/jira-cli) configured via ~/.config/.jira/.config.yml and JIRA_API_TOKEN.",
      "additionalProperties": false,
      "required": ["server", "login"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "server": { "type": "string", "description": "Jira base URL (e.g. https://your-org.atlassian.net)." },
        "login": { "type": "string", "description": "Jira account email (Cloud) or username (Server/DC)." },
        "apiToken": { "type": "string" },
        "apiTokenFile": { "type": "string" },
        "apiTokenEnv": { "type": "string" },
        "installation": { "type": "string", "enum": ["cloud", "local"], "default": "cloud" },
        "authType": { "type": "string", "enum": ["basic", "bearer", "mtls"], "default": "basic" },
        "projectKey": { "type": "string" },
        "projectType": { "type": "string" },
        "boardId": { "type": "integer" },
        "boardName": { "type": "string" },
        "boardType": { "type": "string" }
      }
    },
    "upcloud": {
      "type": "object",
      "description": "UpCloud CLI (upctl) configured via ~/.config/upctl.yaml and optional UPCLOUD_TOKEN.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "token": { "type": "string" },
        "tokenFile": { "type": "string" },
        "tokenEnv": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "passwordFile": { "type": "string" },
        "passwordEnv": { "type": "string" },
        "exportEnv": { "type": "boolean", "default": true }
      }
    },
    "kubectl": {
      "type": "object",
      "description": "Kubernetes CLI (kubectl) configured via a kubeconfig file or direct Service Account bearer token.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "kubeconfigFile": { "type": "string", "description": "Windows path to a dedicated sandbox kubeconfig file." },
        "context": { "type": "string", "description": "Optional context name to activate with 'kubectl config use-context'." },
        "server": { "type": "string", "description": "Kubernetes API server URL (for token-based kubeconfig generation)." },
        "token": { "type": "string" },
        "tokenFile": { "type": "string" },
        "tokenEnv": { "type": "string" },
        "caCertFile": { "type": "string", "description": "Optional Windows path to cluster CA PEM file (for token-based kubeconfig)." },
        "caCertData": { "type": "string", "description": "Optional base64-encoded CA certificate data." },
        "insecureSkipTlsVerify": { "type": "boolean", "default": false },
        "namespace": { "type": "string", "default": "default" },
        "clusterName": { "type": "string", "default": "sandbox" },
        "userName": { "type": "string", "default": "sandbox-sa" },
        "contextName": { "type": "string", "default": "sandbox" }
      }
    },
    "gemini": {
      "type": "object",
      "description": "Gemini CLI API key or Vertex AI environment configuration.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "apiKey": { "type": "string" },
        "apiKeyFile": { "type": "string" },
        "apiKeyEnv": { "type": "string" },
        "googleCloudProject": { "type": "string" },
        "googleCloudLocation": { "type": "string" },
        "useVertexAi": { "type": "boolean", "default": false }
      }
    },
    "claude": {
      "type": "object",
      "description": "Claude Code API key or OAuth token configuration.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "apiKey": { "type": "string" },
        "apiKeyFile": { "type": "string" },
        "apiKeyEnv": { "type": "string" },
        "oauthToken": { "type": "string" },
        "oauthTokenFile": { "type": "string" },
        "oauthTokenEnv": { "type": "string" }
      }
    },
    "env": {
      "type": "object",
      "description": "Additional machine account tokens or API keys exported into ~/.config/wsl-agent-sandbox/secrets.env.",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": { "type": "string" },
                "valueFile": { "type": "string" },
                "valueEnv": { "type": "string" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "description": "Additional secret files copied atomically from Windows into paths strictly inside /home/<agent>/.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourcePath", "targetPath"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
          "enabled": { "type": "boolean", "default": true },
          "sourcePath": { "type": "string", "description": "Windows path (relative to manifest directory or absolute, supports %ENVVAR%)." },
          "targetPath": { "type": "string", "description": "Linux target path strictly inside /home/<agent>/ (may start with '~/')." },
          "mode": { "type": "string", "pattern": "^0?[0-7]{3}$", "default": "0600" }
        }
      }
    }
  }
}
