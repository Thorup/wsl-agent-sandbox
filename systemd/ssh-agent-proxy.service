[Unit]
Description=wsl-agent-sandbox Root-Mediated Filtered SSH Agent Proxy
After=box-hardening.service
Wants=box-hardening.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=+/usr/local/sbin/box-ssh-agent-ctl.sh ensure-upstream
ExecStart=/usr/bin/python3 /usr/local/sbin/box-ssh-agent-proxy.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=ssh-agent-proxy
RuntimeDirectoryMode=0755
ReadWritePaths=-/run/box-root
MemoryMax=128M

[Install]
WantedBy=multi-user.target
